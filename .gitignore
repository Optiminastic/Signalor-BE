# Python
*.pyc
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
local.env
producation.env
production.env
staging.env

# Django
# db.sqlite3
*.log
*.log.*
logs/*.log
logs/*.log.*
staticfiles/
media/

# Environment
.env
.env.local
.env.*.local

# Per-environment config (env/ folder is committed; actual values are not)
env/*.env
!env/example.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Cache
.pytest_cache/
.coverage
htmlcov/

.env*

# Hetzner deploy — live secrets (template is committed as deploy/stack.env.example)
deploy/stack.env
# Cloudflare Origin Certificate (private key) — never commit
deploy/certs/
origin.cert
# concurrent-log-handler runtime lock files
logs/*.lock
deploy/stack.local.env
# Editor/manual backups of the above. A suffix is all it took for
# deploy/stack.local.env.bak to slip past the rules above and reach a commit.
*.bak
*.orig
*~
deploy/stack*.env
!deploy/stack*.env.example
